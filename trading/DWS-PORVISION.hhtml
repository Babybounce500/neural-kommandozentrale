            <p class="text-gray-500">Alle Investmentfonds mit ISIN, WKN, Ticker & Produktschlüssel • 2025</p>
            <div class="mt-4">
                <input type="text" id="search" placeholder="🔍 Suche..." class="w-full p-3 bg-gray-900 border border-green-900/50 rounded text-green-400" onkeyup="filterTable()">
            </div>
        </header>

