
<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>DWS & GENERALI • COMPLETE FUNDS DATABASE</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        body { background: #0a0f0a; color: #e0e0e0; font-family: sans-serif; }
        .glass { background: rgba(10, 20, 10, 0.9); border: 1px solid rgba(0, 255, 136, 0.2); }
        .fund-row:hover { background: rgba(0, 255, 136, 0.05); }
        .copy-btn { 
            padding: 3px 8px; font-size: 10px; background: rgba(0, 255, 136, 0.1); 
            border: 1px solid rgba(0, 255, 136, 0.3); border-radius: 3px; cursor: pointer; 
        }
        .copy-btn:hover { background: rgba(0, 255, 136, 0.2); }
    </style>
</head>
<body class="p-4">
    <div class="max-w-[1600px] mx-auto">
        <header class="mb-6 pb-4 border-b border-green-900/30">
